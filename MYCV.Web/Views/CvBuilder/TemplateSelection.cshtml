@using MYCV.Domain.Enums
@model List<MYCV.Application.DTOs.CvTemplateDto>

@{
    ViewData["Title"] = "Template Selection";

    var currentStep = (int)CvStep.TemplateSelection;

    var completedSteps = new List<int>
    {
        (int)CvStep.PersonalDetail,
        (int)CvStep.Education,
        (int)CvStep.WorkExperience,
        (int)CvStep.Skills,
        (int)CvStep.Projects,
        (int)CvStep.Languages,
        (int)CvStep.SummaryObjective,
        (int)CvStep.References
    };
}

<section class="py-5 bg-light">
    <div class="container">

        <!-- HEADER -->
        <div class="text-center mb-4">
            <h2 class="fw-bold">Choose Your CV Template</h2>
            <p class="text-muted">Select a professional template to continue</p>
        </div>

        <div class="row">

            <!-- LEFT STEPS -->
            <div class="col-lg-3 mb-4">
                @await Component.InvokeAsync("CvStepNavigation", new
                    {
                        currentStep = currentStep,
                        completedSteps = completedSteps
                    })
            </div>

            <!-- RIGHT CONTENT -->
            <div class="col-lg-9">

                <div class="row g-4">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <div class="col-lg-4 col-md-6">

                                <div class="template-card @(item.IsPremium ? "border-warning" : "")"
                                     data-template-id="@item.Id">

                                    <!-- TICK -->
                                    <div class="selected-tick">
                                        <i class="bi bi-check-lg"></i>
                                    </div>

                                    <div class="template-image-wrapper">

                                        <img src="@item.ImageUrl" class="template-image" />

                                        <div class="template-overlay">

                                            <button class="btn btn-light btn-sm"
                                                    type="button"
                                                    onclick="previewTemplate('@item.ImageUrl')">
                                                Preview
                                            </button>

                                            <button class="btn btn-primary btn-sm"
                                                    type="button"
                                                    onclick="selectTemplate(@item.Id, this)">
                                                Select
                                            </button>

                                        </div>

                                    </div>

                                    <div class="p-2 text-center">
                                        <h6 class="fw-bold mb-1">@item.Title</h6>
                                        <small class="text-muted">@item.Description</small>
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted fw-bold">
                            No templates found
                        </div>
                    }

                </div>

            </div>
        </div>

        <!-- BUTTON -->
        <div class="d-flex justify-content-end mt-4">
            <button type="button"
                    class="btn btn-primary"
                    id="btnContinue"
                    disabled
                    onclick="goToPreview()">
                Save & Continue →
            </button>
        </div>

    </div>
</section>

<!-- PREVIEW MODAL -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark">

            <div class="modal-header border-0">
                <h5 class="text-white">Template Preview</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body d-flex justify-content-center align-items-center">
                <img id="previewImage" style="max-width:90%; max-height:90%;" />
            </div>

        </div>
    </div>
</div>

@section Styles {
    <style>

        .template-card {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
            transition: 0.3s;
            cursor: pointer;
        }

            .template-card:hover {
                transform: translateY(-5px);
            }

        .template-image-wrapper {
            position: relative;
            overflow: hidden;
        }

        .template-image {
            width: 100%;
            height: 280px;
            object-fit: cover;
            transition: 0.4s;
        }

        .template-card:hover .template-image {
            transform: scale(1.08);
        }

        .template-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,.55);
            display: flex;
            gap: 10px;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: 0.3s;
        }

        .template-card:hover .template-overlay {
            opacity: 1;
        }

        /* TICK MARK */
        .selected-tick {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #198754;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            opacity: 0;
            z-index: 2;
            transition: 0.2s;
        }

        .template-card.selected .selected-tick {
            opacity: 1;
        }

        .template-card.selected {
            border: 2px solid #0d6efd;
        }

    </style>
}

@section Scripts {
    <script>

        let selectedTemplateId = 0;

        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("btnContinue").disabled = true;
        });

        // ================= SELECT =================
        function selectTemplate(templateId, btn) {

            selectedTemplateId = templateId;

            document.querySelectorAll('.template-card').forEach(c => {
                c.classList.remove('selected');
            });

            const card = btn.closest('.template-card');
            card.classList.add('selected');

            document.getElementById("btnContinue").disabled = false;
        }

        // ================= PREVIEW =================
        function previewTemplate(imageUrl) {
            document.getElementById('previewImage').src = imageUrl;
            new bootstrap.Modal(document.getElementById('previewModal')).show();
        }

        // ================= SAVE =================
        async function goToPreview() {

            if (selectedTemplateId === 0) return;

            try {
                const response = await fetch('/CvBuilder/SaveTemplateSelection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ templateId: selectedTemplateId })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    window.location.href = '/CvBuilder/PreviewDownload';
                }
                else {
                    alert(data.message || "Failed to save template");
                }
            }
            catch (err) {
                console.error(err);
                alert("Something went wrong");
            }
        }

    </script>
}