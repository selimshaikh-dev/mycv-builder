@model MYCV.Application.DTOs.CvPreviewDto

<!-- Google Fonts & Font Awesome -->
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style>

    /* ================= RESET ================= */
    .cv-template * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Inter', sans-serif;
    }

    /* ================= BODY ================= */
    .cv-template {
        background: #f4f7fc;
        color: #1a2c3e;
        line-height: 1.5;
    }

        /* ================= CONTAINER ================= */
        .cv-template .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }

        /* ================= CARD ================= */
        .cv-template .card {
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: 0 8px 20px rgba(0,0,0,0.05);
            padding: 1.8rem 2rem;
            margin-bottom: 2rem;
            transition: 0.2s;
        }

            .cv-template .card:hover {
                box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            }

        /* ================= HERO ================= */
        .cv-template .hero {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            justify-content: space-between;
            align-items: center;
        }

        .cv-template .profile-left {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .cv-template .avatar-placeholder {
            width: 120px;
            height: 120px;
            background: linear-gradient(145deg, #0b5e7e, #0a4b64);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 3rem;
            font-weight: 600;
        }

        /* ================= NAME ================= */
        .cv-template .name-title h1 {
            font-size: 2.3rem;
            font-weight: 700;
            color: #0a4b64;
        }

        .cv-template .name-title p {
            font-size: 1.2rem;
            color: #2c7da0;
            margin-top: 0.4rem;
        }

        /* ================= CONTACT ================= */
        .cv-template .contact-info {
            background: #eef2f5;
            border-radius: 1.2rem;
            padding: 1rem 1.5rem;
            display: flex;
            flex-wrap: wrap;
            gap: 1.2rem;
            justify-content: space-between;
        }

        .cv-template .contact-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.9rem;
            color: #1e4a6b;
        }

        /* ================= SOCIAL ================= */
        .cv-template .social-links a {
            color: #1e4a6b;
            margin: 0 0.3rem;
            font-size: 1.2rem;
        }

        /* ================= SECTION TITLE ================= */
        .cv-template .section-title {
            font-size: 1.7rem;
            font-weight: 700;
            border-left: 5px solid #2c7da0;
            padding-left: 1rem;
            margin-bottom: 1.5rem;
            color: #0a4b64;
        }

        /* ================= GRID ================= */
        .cv-template .grid-2col {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        /* ================= SKILLS ================= */
        .cv-template .skill-badge {
            display: inline-block;
            background: #e6f4f8;
            color: #0f5e7e;
            padding: 0.3rem 1rem;
            border-radius: 40px;
            font-size: 0.8rem;
            margin: 0.3rem;
        }

        /* ================= JOB ================= */
        .cv-template .job-title {
            font-weight: 700;
            font-size: 1.2rem;
            display: flex;
            justify-content: space-between;
        }

        /* ================= LIST ================= */
        .cv-template .resp-list {
            padding-left: 1.2rem;
            margin-top: 0.5rem;
        }

        /* ================= PROJECT ================= */
        .cv-template .project-item {
            margin-bottom: 1.5rem;
        }

        /* ================= REFERENCES ================= */
        .cv-template .ref-item {
            background: #f8fafc;
            padding: 1rem;
            border-radius: 1rem;
        }

        /* ================= DECLARATION ================= */
        .cv-template .declaration {
            font-style: italic;
            background: #fafcfd;
            padding: 1rem;
            border-radius: 1rem;
        }

</style>

<div class="cv-template">

    <div class="container">

        <!-- ================= HEADER ================= -->
        <div class="card">

            <div class="hero">

                <div class="profile-left">

                    <div class="avatar-placeholder">
                        MS
                    </div>

                    <div class="name-title">
                        <h1>Md. Selim Shaikh</h1>
                        <p>.NET Developer | Full-Stack Specialist</p>
                    </div>

                </div>

                <div class="social-links">
                    <a href="#"><i class="fab fa-linkedin"></i></a>
                    <a href="#"><i class="fab fa-github"></i></a>
                    <a href="#"><i class="fas fa-globe"></i></a>
                </div>

            </div>

            <div class="contact-info">
                <div class="contact-item"><i class="fas fa-map-marker-alt"></i> Dhaka, Bangladesh</div>
                <div class="contact-item"><i class="fas fa-phone-alt"></i> +880 000000000</div>
                <div class="contact-item"><i class="fas fa-envelope"></i> demo@email.com</div>
                <div class="contact-item"><i class="fas fa-language"></i> Bangla, English, Arabic</div>
            </div>

        </div>

        <!-- ================= OBJECTIVE ================= -->
        <div class="card">
            <div class="section-title">Career Objective</div>
            <p>
                To pursue a career that offers challenges and opportunities for continuous self-development.
                Proficient in ASP.NET MVC, C#, SQL Server and full-stack development.
            </p>
        </div>

        <!-- ================= SKILLS ================= -->
        <div class="card">
            <div class="section-title">Technical Skills</div>

            <span class="skill-badge">.NET Core</span>
            <span class="skill-badge">C#</span>
            <span class="skill-badge">ASP.NET MVC</span>
            <span class="skill-badge">Web API</span>
            <span class="skill-badge">SQL Server</span>
            <span class="skill-badge">JavaScript</span>

        </div>

        <!-- ================= EXPERIENCE ================= -->
        <div class="card">
            <div class="section-title">Work Experience</div>

            <div class="job-item">
                <div class="job-title">
                    .NET Developer <span>2022 - Present</span>
                </div>
                <ul class="resp-list">
                    <li>Developed ASP.NET Core applications</li>
                    <li>Built REST APIs</li>
                    <li>Worked with SQL Server</li>
                </ul>
            </div>

        </div>

        <!-- ================= EDUCATION ================= -->
        <div class="card">
            <div class="section-title">Education</div>
            <p>MBS - Accounting</p>
            <p>BBS - Accounting</p>
        </div>

        <!-- ================= PROJECTS ================= -->
        <div class="card">
            <div class="section-title">Projects</div>

            <div class="project-item">
                <b>Resume Management System</b>
                <p>ASP.NET Core + React</p>
            </div>

        </div>

        <!-- ================= REFERENCES ================= -->
        <div class="card">
            <div class="section-title">References</div>

            <div class="ref-item">
                <b>Mr. Example</b> - Manager
            </div>

        </div>

        <!-- ================= DECLARATION ================= -->
        <div class="card">
            <div class="section-title">Declaration</div>

            <div class="declaration">
                I hereby declare that all information is true.
            </div>

        </div>

    </div>

</div>